<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="TSPPrefs.xml" />
        <exclude domain="sharedpref" path="WebViewChromiumPrefs.xml" />
        <exclude domain="file" path="app_webview" />
        <exclude domain="file" path="app_webview_cache" />
        <exclude domain="database" path="webview.db" />
        <exclude domain="database" path="webviewCache.db" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="TSPPrefs.xml" />
        <exclude domain="sharedpref" path="WebViewChromiumPrefs.xml" />
        <exclude domain="file" path="app_webview" />
        <exclude domain="file" path="app_webview_cache" />
        <exclude domain="database" path="webview.db" />
        <exclude domain="database" path="webviewCache.db" />
    </device-transfer>
</data-extraction-rules>
