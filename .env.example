# Copy to web/.env.local (never commit real values).
# Netlify dashboard should also set these.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# GA4 gtag (RepairPlanet web stream). Optional — production falls back to
# G-GNBJQ2DMQB if unset. Set in Netlify (Site configuration > Environment
# variables, Production context) if you want to override the default.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-GNBJQ2DMQB

# Stripe — invoice pay links AND marketplace parts Purchase use the same secret.
# Production (repairplanet.net): set the existing live RepairPlanet / TSP invoice
# secret (starts with sk_live_). Do not set sk_test_ on the Production context.
# Names only — paste values only in Netlify / local .env, never in git.
# Preferred:
# STRIPE_SECRET_KEY=
# Fallback alias (used if STRIPE_SECRET_KEY is unset, or if this one is live
# and STRIPE_SECRET_KEY is a leftover test key):
# STRIPE_SECRET=
#
# Webhook signing secret for /api/billing/upgrade/webhook.
# Platform endpoint: checkout.session.completed and subscription lifecycle events.
# STRIPE_WEBHOOK_SECRET=
# Connect endpoint ("Events on connected accounts") on the same URL, for
# account.updated. Either secret verifies the request.
# STRIPE_CONNECT_WEBHOOK_SECRET=
#
# Stripe Connect. A charges-enabled seller uses a destination charge.
# STRIPE_CONNECT_ENFORCE defaults off: an unconnected company keeps today's
# platform charge (no transfer_data, application fee, or on_behalf_of).
# Set to on only after sellers finish Express onboarding.
# STRIPE_CONNECT_ENFORCE=
# Comma-separated orgs that always stay on the platform charge, even when
# enforce is on. Defaults to 4 when unset.
# STRIPE_CONNECT_EXEMPT_ORG_IDS=4
# Connect must be enabled on the same Stripe account as STRIPE_SECRET_KEY.
# No separate Connect client id is required for Express accounts created by the API.
#
# Larry's Stripe partner / referral signup URL. Shown next to Connect onboarding
# when a shop or parts supplier does not have Stripe yet. Leave unset rather
# than inventing a URL: the app still offers Connect and tells the user to ask
# the platform admin for the partner link.
# STRIPE_PARTNER_REFERRAL_URL=
#
# Optional platform application fee in basis points (100 bps = 1%). Default 0.
# STRIPE_PLATFORM_FEE_BPS=0

# Resend — transactional mail (estimates, invites, complimentary Premium trial).
# Production already uses this for shop/clinic invites. Required for the
# 60-day Premium trial gift email on God "Grant complimentary Premium".
# RESEND_API_KEY=
# Optional From / reply overrides (default: Total Service Pro <contact@medicalrepairnetwork.com>):
# NOTIFY_FROM_EMAIL=Total Service Pro <contact@medicalrepairnetwork.com>
# RESEND_FROM=
# NOTIFY_REPLY_TO=contact@medicalrepairnetwork.com

# God dashboard (Larry only). Server-side allowlist — not a Stripe plan.
# Comma-separated emails; defaults to larrysmart@gmail.com when unset.
# GOD_ADMIN_EMAILS=
# GOD_ADMIN_USER_IDS=

# Optional. God “Attach to Grok collection” / “Attach missing Grok collections”
# proxy grok-assistant (function XAI_API_KEY). Set these on Netlify only if the
# Next.js API should upload without that proxy. Management key is required by
# xAI to add files to a collection.
# Mobile voice (`supabase/functions/grok-tts`) uses that same Supabase function
# secret. Do not put XAI_API_KEY in the Android/iOS app, and do not add a
# Netlify variable just for TTS.
# XAI_API_KEY=
# XAI_MANAGEMENT_API_KEY=

# God Analytics (GA4 Data API). Server-only — never NEXT_PUBLIC_ or commit the key.
# Property: Living Free - GA4 (365480892). Stream: RepairPlanet / G-GNBJQ2DMQB.
# Soft beta: do not link Google Ads. Site gtag is NEXT_PUBLIC_GA_MEASUREMENT_ID.
# GA4_PROPERTY_ID=365480892
# GA4_MEASUREMENT_ID=G-GNBJQ2DMQB
# Preferred: paste the service-account JSON (raw or base64) as one secret:
# GA4_SERVICE_ACCOUNT_JSON=
# Or split fields (Netlify: use literal \n in the private key):
# GA4_CLIENT_EMAIL=
# GA4_PRIVATE_KEY=
