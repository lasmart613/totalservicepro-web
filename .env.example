# Copy to web/.env.local (never commit real values).
# Netlify dashboard should also set these.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Stripe — invoice pay links AND marketplace parts Purchase use the same secret.
# Production (repairplanet.net): set the existing live RepairPlanet / TSP invoice
# secret (starts with sk_live_). Do not set sk_test_ on the Production context.
# Names only — paste values only in Netlify / local .env, never in git.
# Preferred:
# STRIPE_SECRET_KEY=
# Fallback alias (used if STRIPE_SECRET_KEY is unset, or if this one is live
# and STRIPE_SECRET_KEY is a leftover test key):
# STRIPE_SECRET=

# God dashboard (Larry only). Server-side allowlist — not a Stripe plan.
# Comma-separated emails; defaults to larrysmart@gmail.com when unset.
# GOD_ADMIN_EMAILS=
# GOD_ADMIN_USER_IDS=
